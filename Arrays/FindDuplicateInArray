public class FindDuplicateInArray {

    public static void main(String[] args){
//        Array size = 6
//        Possible values = 1 to 5
//        [1, 3, 4, 2, 2, 5]
//          find one repetate number
        int[] input_arr = {1, 3, 4, 2, 2, 5};
        System.out.println("value is "+FindDuplicateInArray.solution_brute_force_logic(input_arr));
        FindDuplicateInArray.solution_hash_set(input_arr);
    }

    public static int solution_brute_force_logic(int[] input_arr){
        int ouputValue=0;
        for(int i=0; i < input_arr.length; i++){
            int value = input_arr[i];
            for(int j =i+1; j < input_arr.length; j++){
                if(input_arr[j] == value){
                    ouputValue = value;
                    return ouputValue;
                }
            }
        }
        return ouputValue;
    }

    public static int solution_hash_set(int[] input_arr){
        int outputValue = 0;
        Set<Integer> uniqueList = new HashSet<>();
        for(int i = 0; i < input_arr.length; i++){
            if(uniqueList.contains(input_arr[i])){
               System.out.println("Repetative Value is "+ input_arr[i]);
               outputValue = input_arr[i];
               return outputValue;
            } else {
                uniqueList.add(input_arr[i]);
            }
        }
        return outputValue;
    }


    public static int findDuplicateSorting(int[] nums) {
        Arrays.sort(nums);
        for (int i = 0; i < nums.length - 1; i++) {
            if (nums[i] == nums[i + 1]) {
                return nums[i];
            }
        }
        return -1;
    }

    public static int findDuplicateNegativeMarking(int[] nums) {

        for (int i = 0; i < nums.length; i++) {

            int index = Math.abs(nums[i]);

            if (nums[index] < 0) {
                return index;
            }

            nums[index] = -nums[index];
        }

        return -1;
    }

    public static int findDuplicateFloyd(int[] nums) {

        int slow = nums[0];
        int fast = nums[0];

        // Detect cycle
        do {
            slow = nums[slow];
            fast = nums[nums[fast]];
        } while (slow != fast);

        // Find cycle entry
        slow = nums[0];

        while (slow != fast) {
            slow = nums[slow];
            fast = nums[fast];
        }

        return slow;
    }
}
