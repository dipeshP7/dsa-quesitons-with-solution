class ListNode{
    int val;
    ListNode next;

    ListNode(int val){
        this.val=val;
    }
    ListNode(int val, ListNode node){
        this.val=val;
        this.next=node;
    }

    @Override
    public String toString() {
        return "val : "+this.val+ " : next : "+this.next;
    }
}

public class MergeSortedTwoList {

    public static void main(String[] args){
        //input list1  = {1,3,5}, list2= {2,4,6}
        //output : {1,2,3,4,5,6}
        int[] numbers1 = {5,3,1}, numbers2={6,4,2};
        int[] numbers3 = {5,3}, numbers4={4,2};

        ListNode list1=null,list2=null;
        for(int i=0; i < numbers3.length; i++){
            list1= new ListNode(numbers3[i], list1);
        }
        for(int i=0; i < numbers4.length; i++){
            list2= new ListNode(numbers4[i], list2);
        }

       // MergeSortedTwoList.basic_approach(list1, list2);
      // ListNode outputNode = MergeSortedTwoList.mergeTwoLists(list1, list2);
        ListNode outputNode = MergeSortedTwoList.cloneSolution(list1, list2);
        MergeSortedTwoList.printList(outputNode);
    }

    public static void printList(ListNode head) {
        while (head != null) {
            System.out.print(head.val);
            if (head.next != null) {
                System.out.print(" -> ");
            }
            head = head.next;
        }
        System.out.println();
    }


    public static ListNode mergeTwoLists(ListNode list1, ListNode list2) {
        // Dummy node to simplify handling the head
        ListNode dummy = new ListNode(-1);
        // Current pointer for merged list
        ListNode current = dummy;
        while (list1 != null && list2 != null) {
            if (list1.val <= list2.val) {
                current.next = list1;
                list1 = list1.next;
            } else {
                current.next = list2;
                list2 = list2.next;
            }
            System.out.println("current : "+current.val+ " next : "+current.next);
            current = current.next;
        }
        // Attach remaining nodes
        if (list1 != null) {
            current.next = list1;
        }
        if (list2 != null) {
            current.next = list2;
        }
        return dummy.next;
    }


    public static ListNode cloneSolution(ListNode node1, ListNode node2 ){

        ListNode dummy = new ListNode(-1);
        ListNode mergeNode=dummy;
        while(node1 != null && node2 != null){

            if(node1.val <= node2.val){
                mergeNode.next=node1;
                node1=node1.next;
            }else{
                mergeNode.next=node2;
                node2=node2.next;
            }
            mergeNode=mergeNode.next;
        }

        if(node1 !=null){
            mergeNode.next=node1;
        }
        if(node2 != null){
            mergeNode.next=node2;
        }

        return  dummy.next;
    }
}
