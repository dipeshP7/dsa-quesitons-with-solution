    //logic
    //use pair removed
    // check if has pair like current index with next index
    //then remove this pair
    //then start again with same string
    //every time match pair remove
    // at last string will be empty or blank - > valid
    //otherwise invalid
    public static boolean solution_brute_force(String inputString){
        StringBuilder sb = new StringBuilder(inputString);
        boolean pairMatched = true;
        while(pairMatched){
            pairMatched = false;
            for(int i =0; i < sb.length() -1; i++){
                char first = sb.charAt(i);
                char second = sb.charAt(i+1);
                if((first == '(' && second == ')')
                    || (first == '[' && second == ']')
                    || (first == '{' && second == '}') ){
                    // here second +1 is used because string builder
                    // delele method accept start index -inclusive
                    // end index - exclusive
                    // means end index spaciy will exlude while delete
                    sb.delete(i,i+2);
                    pairMatched = true;
                    break;
                }
            }
        }
        return sb.length() == 0;
    }

    public static boolean solution_stack_approch(String inputString){
        Stack<Character> stack = new Stack<>();
        for(char ch :  inputString.toCharArray()){
            if (ch == '(' || ch == '[' || ch == '{') {
              stack.push(ch);
            } else {
                if (stack.isEmpty()) {
                    return false;
                }

                char top = stack.pop();
                if ((ch == ')' && top != '(') ||
                        (ch == ']' && top != '[') ||
                        (ch == '}' && top != '{')) {
                    return false;
                }
            }
        }
        return  stack.isEmpty();
    }
